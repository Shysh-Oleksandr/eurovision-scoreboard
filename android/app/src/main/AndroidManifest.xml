<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: share links (https://douzepoints.app/?contest=…,
                 ?theme=…, ?design=…, ?profile=…) open the app; verified
                 against public/.well-known/assetlinks.json. Matching the
                 query needs Android 15 (uri-relative-filter-group). Older
                 versions skip the groups and see only the path below, which
                 no link uses, so they keep opening the website. Without it
                 they would send every douzepoints.app page to the app,
                 including the website's sign-in redirect.
                 docs/native-apps.md §12. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="douzepoints.app" />
                <data android:path="/app-links-need-android-15" />
                <uri-relative-filter-group>
                    <data android:path="/" />
                    <data android:queryAdvancedPattern="profile=.+" />
                </uri-relative-filter-group>
                <uri-relative-filter-group>
                    <data android:path="/" />
                    <data android:queryAdvancedPattern="contest=.+" />
                </uri-relative-filter-group>
                <uri-relative-filter-group>
                    <data android:path="/" />
                    <data android:queryAdvancedPattern="theme=.+" />
                </uri-relative-filter-group>
                <uri-relative-filter-group>
                    <data android:path="/" />
                    <data android:queryAdvancedPattern="design=.+" />
                </uri-relative-filter-group>
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
