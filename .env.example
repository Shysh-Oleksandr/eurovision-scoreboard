NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Native apps only (docs/native-apps.md §7). Public OAuth client IDs:
# the "Web application" client the backend verifies ID tokens against
# (its GOOGLE_CLIENT_ID) and the "iOS" client for the app's bundle ID.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=
