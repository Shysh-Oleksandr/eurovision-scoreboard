# Copy to fastlane/.env (gitignored) and fill in. The key files stay in
# ~/keys, outside the repository, which is public. docs/store-builds.md
# "Once" says where each value comes from.

# App Store Connect API key (Users and Access → Integrations → App Store
# Connect API → Team Keys; role App Manager).
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=~/keys/AuthKey_XXXXXXXXXX.p8

# Google Play service account JSON key with release and store listing
# permissions on DouzePoints.
PLAY_JSON_KEY=~/keys/douzepoints-play-fastlane.json
